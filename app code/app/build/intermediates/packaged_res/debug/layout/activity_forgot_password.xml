<?xml version="1.0" encoding="utf-8"?>
<!-- 4. 忘記密碼 (3步驟 ViewFlipper) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Hero Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#1a1208"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_lock_lock"
            android:contentDescription="Lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/reset_password"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/reset_subtitle"
            android:textColor="#59FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Step ViewFlipper -->
    <ViewFlipper
        android:id="@+id/resetFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Step 1: Email Entry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step1_title"
                        android:textSize="11sp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etResetEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/registered_email"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/otp_hint"
                        android:textSize="11sp"
                        android:textColor="#999999"
                        android:gravity="center" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/send_otp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackStep1"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/back_to_login" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 2: OTP Verification -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step2_title"
                        android:textSize="11sp"
                        android:layout_marginBottom="12dp" />

                    <!-- OTP 6-digit row -->
                    <LinearLayout
                        android:id="@+id/otpRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="10dp">

                        <EditText android:id="@+id/otp1" android:layout_width="42dp" android:layout_height="50dp" android:gravity="center" android:inputType="number" android:maxLength="1" android:layout_margin="3dp" />
                        <EditText android:id="@+id/otp2" android:layout_width="42dp" android:layout_height="50dp" android:gravity="center" android:inputType="number" android:maxLength="1" android:layout_margin="3dp" />
                        <EditText android:id="@+id/otp3" android:layout_width="42dp" android:layout_height="50dp" android:gravity="center" android:inputType="number" android:maxLength="1" android:layout_margin="3dp" />
                        <EditText android:id="@+id/otp4" android:layout_width="42dp" android:layout_height="50dp" android:gravity="center" android:inputType="number" android:maxLength="1" android:layout_margin="3dp" />
                        <EditText android:id="@+id/otp5" android:layout_width="42dp" android:layout_height="50dp" android:gravity="center" android:inputType="number" android:maxLength="1" android:layout_margin="3dp" />
                        <EditText android:id="@+id/otp6" android:layout_width="42dp" android:layout_height="50dp" android:gravity="center" android:inputType="number" android:maxLength="1" android:layout_margin="3dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOtpResend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:textColor="#999999"
                        android:text="已發送至 j***@example.com\n重新發送（59 秒後）" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerifyOtp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/verify_otp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackStep2"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/back" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 3: Set New Password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step3_title"
                        android:textSize="11sp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/new_password"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/confirm_new_password"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmReset"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/confirm_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackStep3"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/back" />
            </LinearLayout>
        </LinearLayout>

    </ViewFlipper>
</LinearLayout>
