<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable list item for phone numbers -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/ivPhoneAvatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@android:drawable/sym_action_call"
        android:contentDescription="Phone" />

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/tvPhoneNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+886-800-XXX-XXX"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPhoneType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="詐騙電話 · 假冒政府機關"
            android:textSize="10sp"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tvPhoneReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="社群舉報 2,847 次 · 最近 2 小時前"
            android:textSize="9sp"
            android:textColor="#999999" />
    </LinearLayout>

    <!-- Risk Badge -->
    <TextView
        android:id="@+id/tvPhoneBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="詐騙"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>
