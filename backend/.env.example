# ============================================================
# F.L.A.S.H. 後端環境變數範本
#
# 用法：cp .env.example .env，再把 CHANGE_ME 的值換掉。
# .env 含機密，已在 .gitignore 裡，請勿提交。
# 欄位的完整說明在 app/core/config.py；模型與門檻的版本沿革在 docs/VERSIONS.md。
# ============================================================

# ----- 一般 -----
DEBUG=false
# 開發用；正式環境請用 alembic 遷移並保持 false
AUTO_CREATE_TABLES=false
BACKEND_CORS_ORIGINS=["*"]

# ----- 資料庫（MySQL + aiomysql）-----
DATABASE_URL=mysql+aiomysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:3306/flash_db?charset=utf8mb4
DB_ECHO=false

# ----- JWT -----
# 產生：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ----- OTP / 密碼重設 -----
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRE_MINUTES=15

# ----- SMTP（寄 OTP；SMTP_HOST 留空＝開發模式，OTP 只印在後端日誌）-----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@example.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM=F.L.A.S.H. 系統
SMTP_TLS=true

# ----- 社交登入 -----
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
FACEBOOK_APP_ID=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME

# ============================================================
# RAG 偵測
# ============================================================

# RAG 總開關。false＝跳過「嵌入 → 檢索 → 閘門」直接交給 LLM（不需 GPU 與 ChromaDB）。
# ⚠ 要與 OLLAMA_MODEL 成對切換：false 時請改用「未考慮相似案例」的那版微調模型，
#   只改一邊等於讓模型在訓練分布外推論，量到的差異就不是 RAG 的效果。
RAG_ENABLED=true
# 關閉 RAG 時是否保留【待偵測訊息】標頭；對齊該版微調資料的 user 格式
NO_RAG_PROMPT_HEADER=true
# RAG Worker 呼叫 GET /api/v1/rag/reports 的內部金鑰（隨機字串，不是網址）
RAG_API_KEY=CHANGE_ME_RAG_INTERNAL_KEY

# ----- 向量庫與嵌入模型 -----
# ⚠ 換嵌入模型＝換集合名 + 重建向量庫 + 重新校準下面所有門檻（見 docs/VERSIONS.md §7）
CHROMA_DIR=./chroma_data
CHROMA_COLLECTION=scam_messages__google_embeddinggemma_300m
EMBEDDING_MODEL=google/embeddinggemma-300m
# auto（有 CUDA 用 GPU）/ cuda / cuda:0 / cpu
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512
# （未使用，保留相容；要調閘門請改 RAG_GATE_TOP_N）
RAG_TOP_K=5

# ----- 門檻 -----
# 相似案例「注入提示詞」的門檻。★ 釘在訓練契約上，不可為了回應好看而調。
# 換嵌入模型時要用同分位數換算（0.7 在 BGE-M3 ＝ embeddinggemma 的 0.559）。
RAG_CASE_SIMILARITY_THRESHOLD=0.559
# 回應 similar_cases 的「顯示」門檻：只在注入那組為空時用得到，提示詞一個字都不會變。
# 分成兩個值是因為判定只要 0.35，落在中間的訊息會被判成詐騙卻顯示不出佐證案例（31.7%）。
RAG_DISPLAY_SIMILARITY_THRESHOLD=0.35

# ----- 相似度一致性閘門 -----
# 最相似的 N 筆若全部 > 門檻且 is_scam 完全一致，就直接判定（不呼叫 LLM，
# 回應 model 欄為 similarity-gate）；其餘情況交給 LLM。
# ⚠ N 是主要變因（2→3 動 F1 0.006），x 幾乎是擺設（0.25~0.45 只動 0.003）：
#   換嵌入模型時 x 可沿用，N 請重跑 scripts/eval_scam_detection.py --sweep。
# 對照表與 2026-09-15 重掃「維持原值」的理由見 README 的閘門章節。
RAG_GATE_TOP_N=3
RAG_GATE_SIMILARITY=0.35

# ============================================================
# 本地 LLM（Ollama）
# ============================================================

OLLAMA_BASE_URL=http://127.0.0.1:11434
# 偵測模型。⚠ 換模型必須同時確認 app/prompts/scam_detection_system.txt 與該版
# 微調資料的 system 欄逐位元相同，並重跑 scripts/fit_risk_calibration.py。
# 版本沿革與換版理由見 docs/VERSIONS.md §4.1。
OLLAMA_MODEL=flash_v6
OLLAMA_TIMEOUT=120

# ----- 詐騙階段判定（POST /rag/detect-conversation）-----
RAG_STAGE_ENABLED=true
# 階段模型。⚠ 不要指向偵測的微調模型（那是在「單則訊息 → 五個固定中文鍵」的窄格式
# 上訓練的）；留空＝沿用 OLLAMA_MODEL，只適合臨時測試。
# ⚠⚠ 模型與 app/prompts/scam_stage_system.txt 是綁死的一組，換模型要一起換 prompt：
#    flash_stage_v5 帶錯版本會複讀到 JSON 不閉合，444 段有 53.8% 判不出來且不報錯。
OLLAMA_STAGE_MODEL=flash_stage_v5
RAG_STAGE_MAX_MESSAGES=30
RAG_STAGE_MAX_CHARS=4000
# 模型判出比 previous_stage 更早的階段時，要採信它所需的最低信心
RAG_STAGE_REGRESS_CONFIDENCE=0.8

# ----- RAG Worker（獨立入庫程式）-----
RAG_BACKEND_URL=http://127.0.0.1:8000
RAG_POLL_INTERVAL_SECONDS=60
TRAINING_DATA_PATH=./data/vector_db.jsonl
RAG_WORKER_STATE_PATH=./rag_worker_state.json

# ============================================================
# 信箱連接（Gmail / Outlook）
# ============================================================

GMAIL_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=CHANGE_ME
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# common（個人＋公司帳號）/ consumers / organizations / 租戶 GUID
OUTLOOK_TENANT=common

# ⚠ 必須與 Google Cloud Console／Azure 登記的轉址網址逐字相同（換網址時三邊一起改）
MAIL_OAUTH_REDIRECT_BASE=https://CHANGE_ME.example.com
MAIL_OAUTH_SUCCESS_REDIRECT=flashapp://mail-callback?status=success&provider=gmail
# refresh_token 的對稱加密金鑰（Fernet）。留空則由 JWT_SECRET_KEY 衍生（開發用）。
# 產生：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_TOKEN_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

MAIL_SYNC_ENABLED=true
MAIL_SYNC_INTERVAL_SECONDS=300
# 單一信箱每輪最多分析封數（避免塞爆本地 LLM）
MAIL_SYNC_MAX_MESSAGES=20
MAIL_SYNC_INITIAL_LOOKBACK_HOURS=24

# ============================================================
# 地端模型分發（App 離線模式；詳見 docs/local_model_deployment.md）
# ============================================================

# 兩顆模型獨立部署、獨立換版，檔名不可相同（簽章綁檔名）。
# SIZE／SHA256 請用 python -m scripts.check_local_model 產生，不要手打。
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_VERSION=5.0
LOCAL_MODEL_FILE_NAME=flash-v5.gguf
# 模型檔在「這台伺服器」上的路徑；留空＝尚未部署，端點回 503
LOCAL_MODEL_PATH=./models/flash_v5.gguf
LOCAL_MODEL_SIZE_BYTES=0
LOCAL_MODEL_SHA256=
# 對外正式網域（留空則以請求的 base_url 組下載網址，僅適合本機開發）
LOCAL_MODEL_PUBLIC_BASE_URL=
LOCAL_MODEL_URL_EXPIRE_HOURS=24
# 設成 Nginx 的 internal location（例 /protected-models）後改由 Nginx 送檔；
# 留空則由後端自己串流（一樣支援 Range，但吞吐差）
LOCAL_MODEL_XACCEL_LOCATION=
# X-Accel 模式的單一連線限速（bytes/sec，0＝不限）
LOCAL_MODEL_RATE_LIMIT_BYTES_PER_SEC=0

# 第二顆：階段判定模型（沒部署時只有它回 503，偵測那條線照常）
LOCAL_MODEL_STAGE_ENABLED=true
LOCAL_MODEL_STAGE_VERSION=2.0
LOCAL_MODEL_STAGE_FILE_NAME=flash-stage-v2.gguf
LOCAL_MODEL_STAGE_PATH=./models/flash_stage_v2.gguf
LOCAL_MODEL_STAGE_SIZE_BYTES=0
LOCAL_MODEL_STAGE_SHA256=
