<?xml version="1.0" encoding="utf-8"?>
<!-- 設定頁的「訊息」圖示：直接用跟底部導覽列同一份字形（ic_glyph_message），
     不另外做一顆細線版——樣式照 UI 同學原本的設計，這裡只透過 ImageView 容器
     大小（見 SettingsFragment.applyIconScale）讓它能跟著文字大小等比縮放。 -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ic_glyph_message"
    android:tint="@color/steel_blue"
    android:gravity="fill" />
