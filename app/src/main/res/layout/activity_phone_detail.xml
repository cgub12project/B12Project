<?xml version="1.0" encoding="utf-8"?>
<!-- 13. 電話詳情（8/17 改版：配色與四顆操作圖示改用設計稿版本） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/card">

        <!-- Back（維持跟其他詳情頁一樣的「‹ 返回…」樣式） -->
        <LinearLayout
            android:id="@+id/btnBackToPhoneList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/back_to_phone_list"
                android:textSize="11sp"
                android:textColor="@color/steel_blue" />
        </LinearLayout>

        <!-- Phone Number -->
        <TextView
            android:id="@+id/tvPhoneNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+886-800-XXX-XXX"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/warm_grey"
            android:layout_marginBottom="6dp" />

        <!-- Risk Badge -->
        <TextView
            android:id="@+id/tvPhoneRisk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fraud"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/on_risk_title"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="12dp" />

        <!-- 非常規台灣電話格式提示 -->
        <TextView
            android:id="@+id/tvPhoneFormatWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ 非常規台灣電話格式"
            android:textColor="@color/risk_mid"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Stats Row（設計稿：舉報次數＝銹紅、最近舉報＝赤陶、詐騙類型＝暖灰） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_stat_box">

                <TextView
                    android:id="@+id/tvReportCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2,847"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/risk_high" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_count"
                    android:textSize="9sp"
                    android:textColor="@color/warm_grey" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_stat_box">

                <TextView
                    android:id="@+id/tvLastReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 小時前"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/risk_mid" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/last_report"
                    android:textSize="9sp"
                    android:textColor="@color/warm_grey" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_stat_box">

                <TextView
                    android:id="@+id/tvFraudType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="假冒政府機關"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/warm_grey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fraud_type"
                    android:textSize="9sp"
                    android:textColor="@color/warm_grey" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons Row（四顆共用中性米白底，語意交給彩色圖示；
             圖示與電話列表展開面板、郵件展開面板為同一組 drawable） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnDial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="11dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_neutral"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_action_dial"
                    android:contentDescription="@string/dial" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial"
                    android:textSize="9sp"
                    android:textColor="@color/warm_grey"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnBlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="11dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_neutral"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_action_block"
                    android:contentDescription="@string/block" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/block"
                    android:textSize="9sp"
                    android:textColor="@color/warm_grey"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnReport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="11dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_neutral"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_action_report"
                    android:contentDescription="@string/report" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report"
                    android:textSize="9sp"
                    android:textColor="@color/warm_grey"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="11dp"
                android:background="@drawable/bg_btn_neutral"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_action_share"
                    android:contentDescription="@string/share" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/share"
                    android:textSize="9sp"
                    android:textColor="@color/warm_grey"
                    android:layout_marginTop="5dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Section Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/community_reports"
        android:textSize="11sp"
        android:textColor="@color/lbl3"
        android:letterSpacing="0.06"
        android:textAllCaps="true"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />

    <!-- Community Reports List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCommunityReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false" />
</LinearLayout>
