<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMailAccountEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="service@example.com"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMailAccountStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Gmail · 上次同步：—"
            android:textSize="11sp"
            android:textColor="#8C8480" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMailAccountDisconnect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="中斷連接"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#A63D2F"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

</LinearLayout>
