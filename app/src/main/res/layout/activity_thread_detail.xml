<?xml version="1.0" encoding="utf-8"?>
<!-- 11. 對話詳情 (Thread) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Thread Header -->
    <LinearLayout
        android:id="@+id/threadHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FDFAF4">

        <!-- Back Row -->
        <LinearLayout
            android:id="@+id/btnBackToMessages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/back_to_messages"
                android:textSize="11sp"
                android:textColor="#4A7FA5" />
        </LinearLayout>

        <!-- Sender Info + Risk Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvThreadGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LINE · 台灣投資達人"
                    android:textSize="10sp"
                    android:textColor="#8C8480" />

                <TextView
                    android:id="@+id/tvThreadSender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="陳大富"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRiskPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH 91"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_risk_pill_high" />
        </LinearLayout>
    </LinearLayout>

    <!-- Thread Summary Stats -->
    <LinearLayout
        android:id="@+id/threadSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvThreadScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="91"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvThreadScoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversation_risk_score_label"
                android:textSize="9sp"
                android:textColor="#8C8480" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#C8C4C0" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvThreadMsgs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14 則"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suspect_msgs"
                android:textSize="9sp"
                android:textColor="#8C8480" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#C8C4C0" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvThreadDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 天"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_days"
                android:textSize="9sp"
                android:textColor="#8C8480" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pattern Tags -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupPatterns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="10dp">

        <!-- layout_height 改用 wrap_content（原本固定 36dp）：字體調到「特大」（1.5x）時，
             固定高度裝不下放大後的文字，會被垂直裁掉只剩一半，見使用者黑箱測試回報 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReportAccount"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:layout_marginEnd="8dp"
            android:text="回報此帳號為詐騙"
            android:textSize="11sp"
            app:icon="@android:drawable/ic_dialog_alert"
            app:iconSize="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGroupExplanation"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:text="查看整體對話判斷"
            android:textSize="11sp"
            android:visibility="gone"
            app:icon="@android:drawable/ic_menu_info_details"
            app:iconSize="14dp" />
    </LinearLayout>

    <!-- Chat Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false" />
</LinearLayout>
