<?xml version="1.0" encoding="utf-8"?>
<!-- 10. 設定頁 (Tab 4) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- Top Bar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:padding="16dp" />

        <!-- Profile Card -->
        <LinearLayout
            android:id="@+id/profileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_gradient_blue_135"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:padding="18dp">

            <ImageView
                android:id="@+id/profileAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/bg_avatar_circle"
                android:padding="10dp"
                android:contentDescription="Avatar" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#66FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_pro"
                    android:textSize="9sp"
                    android:textColor="@color/gold"
                    android:textStyle="bold"
                    android:background="@drawable/bg_plan_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>

        <!-- 顯示 Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="顯示"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 文字大小 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingFontSize" />

        <!-- 監控設定 Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monitoring_section"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 訊息即時監控 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingMsgMonitor" />

        <!-- 郵件掃描 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingEmailScan" />

        <!-- 來電辨識 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingCallerId" />

        <!-- 安全 Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/security_section"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <!-- 快速登入 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingQuickLogin" />

        <!-- 通知 Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notification_section"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <!-- 高危警報通知 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingHighRiskAlert" />

        <!-- 每日安全報告 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingDailyReport" />

        <!-- 帳號 Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_section"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <!-- 更改密碼 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingChangePassword" />

        <!-- 隱私與資料 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingPrivacy" />

        <!-- 我的回報紀錄 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingMyReports" />

        <!-- 可疑帳號列表 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingSuspectAccounts" />

        <!-- 封鎖名單 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingBlockedNumbers" />

        <!-- 登出 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingLogout" />

    </LinearLayout>
</ScrollView>
