<?xml version="1.0" encoding="utf-8"?>
<!-- 10. 設定頁 (Tab 4) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- Top Bar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:padding="16dp" />

        <!-- Profile Card -->
        <LinearLayout
            android:id="@+id/profileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_gradient_blue_135"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:padding="18dp">

            <ImageView
                android:id="@+id/profileAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/bg_avatar_circle"
                android:padding="10dp"
                android:contentDescription="Avatar" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#66FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_pro"
                    android:textSize="9sp"
                    android:textColor="@color/dusty_terracotta"
                    android:textStyle="bold"
                    android:background="@drawable/bg_plan_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>

        <!-- 顯示 Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="顯示"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 文字大小 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingFontSize" />
        <!-- 預設雲端；地端會等模型下載與本機推論完成才可開啟。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_detection_section"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingDetectionMode" />



        <!-- 監控設定 Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monitoring_section"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 訊息即時監控 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingMsgMonitor" />

        <!-- 郵件掃描 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingEmailScan" />

        <!-- 來電辨識 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingCallerId" />

        <!-- 安全 Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/security_section"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <!-- 快速登入 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingQuickLogin" />

        <!-- 通知 Section：底下兩項目前沒有實際發送通知的機制（沒有 WorkManager/推播），
             先隱藏整個區塊，等真的實作再打開，見 SettingsFragment.kt 的說明註解 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notification_section"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- 高危警報通知：只有一個跟後端同步的開關，沒有任何實際推播/通知邏輯，先隱藏 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingHighRiskAlert"
            android:visibility="gone" />

        <!-- 每日安全報告：同上，只有開關沒有實際產生/發送報告的邏輯，先隱藏 -->
        <include layout="@layout/item_settings_toggle"
            android:id="@+id/settingDailyReport"
            android:visibility="gone" />

        <!-- 帳號 Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_section"
            android:textSize="11sp"
            android:textColor="@color/lbl3"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <!-- 更改密碼 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingChangePassword" />

        <!-- 隱私與資料：點擊只會顯示「尚未實作」Toast，先隱藏，見 SettingsFragment.kt -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingPrivacy"
            android:visibility="gone" />

        <!-- 我的回報紀錄 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingMyReports" />

        <!-- 可疑帳號列表：後端帳號比對目前只用 (platform, 顯示名稱) 判斷唯一性，同名不同人會
             被誤判成同一筆、封鎖/回報會誤傷，等後端修好帳號比對邏輯之後再打開，見 dev-notes 問題16 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingSuspectAccounts"
            android:visibility="gone" />

        <!-- 封鎖名單 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingBlockedNumbers" />

        <!-- 封鎖信箱 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingBlockedEmails" />

        <!-- 已連接的信箱 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingMailAccounts" />

        <!-- 登出 -->
        <include layout="@layout/item_settings_nav"
            android:id="@+id/settingLogout" />

    </LinearLayout>
</ScrollView>
