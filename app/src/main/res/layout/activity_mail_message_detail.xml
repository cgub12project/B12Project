<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F0E8">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#FDFAF4"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="郵件詳情"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvRiskBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#2C2825" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#8C8480"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mail_risk_score_label"
                android:textSize="8sp"
                android:textColor="#8C8480"
                android:letterSpacing="0.18"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvRiskScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvReasonsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="判定理由"
                android:textSize="8sp"
                android:textColor="#8C8480"
                android:letterSpacing="0.18"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#2C2825"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvAdviceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="建議"
                android:textSize="8sp"
                android:textColor="#8C8480"
                android:letterSpacing="0.18"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#2C2825"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="信件開頭片段"
                android:textSize="8sp"
                android:textColor="#8C8480"
                android:letterSpacing="0.18"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#2C2825"
                android:background="@drawable/bg_preview_box"
                android:padding="12dp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvPrivacyNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 為保障您的信箱隱私，本系統不會儲存完整信件內容，僅在分析當下讀取、判斷後即捨棄，App 上只會顯示開頭片段。若要查看完整信件，請點擊下方「開啟原信」直接在 Gmail 開啟。"
                android:textSize="11sp"
                android:textColor="#5A756B"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenOriginal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="開啟原信" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
