<?xml version="1.0" encoding="utf-8"?>
<!-- 4. Forgot Password (3-step ViewFlipper) — New Design -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_parchment"
    android:orientation="vertical">

    <!-- Step ViewFlipper -->
    <ViewFlipper
        android:id="@+id/resetFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ════ Step 1: Email Entry ════ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Top Logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:clipToOutline="true"
                        android:contentDescription="Logo"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/splash_brand"
                        android:textColor="@color/warm_charcoal"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password reset"
                    android:textColor="@color/warm_charcoal"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp"
                    android:text="Please type in the Email address for verification"
                    android:textColor="@color/warm_grey"
                    android:textSize="14sp" />

                <!-- Email Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_cream_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="none"
                        app:hintTextColor="@color/warm_grey">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etResetEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="EMAIL ADDRESS"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/warm_charcoal"
                            android:textColorHint="@color/warm_grey" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Send Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Send verification code"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:backgroundTint="@color/steel_blue"
                    app:cornerRadius="30dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackStep1"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/back_to_login"
                    android:textColor="@color/warm_grey"
                    android:textSize="13sp" />

            </LinearLayout>
        </ScrollView>

        <!-- ════ Step 2: OTP Verification ════ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Top Logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:clipToOutline="true"
                        android:contentDescription="Logo"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/splash_brand"
                        android:textColor="@color/warm_charcoal"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We've sent you the code"
                    android:textColor="@color/warm_charcoal"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp"
                    android:text="Please check your email for the verification code"
                    android:textColor="@color/warm_grey"
                    android:textSize="14sp" />

                <!-- OTP Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_cream_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="none"
                        app:hintTextColor="@color/warm_grey">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOtpCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="VERIFICATION CODE"
                            android:inputType="number"
                            android:letterSpacing="0.3"
                            android:maxLength="6"
                            android:textColor="@color/warm_charcoal"
                            android:textColorHint="@color/warm_grey"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Resend hint -->
                <TextView
                    android:id="@+id/tvOtpResend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:textColor="@color/warm_grey"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Verify Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerifyOtp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Verify"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:backgroundTint="@color/steel_blue"
                    app:cornerRadius="30dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackStep2"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/back"
                    android:textColor="@color/warm_grey"
                    android:textSize="13sp" />

            </LinearLayout>
        </ScrollView>

        <!-- ════ Step 3: New Password ════ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Top Logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:clipToOutline="true"
                        android:contentDescription="Logo"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/splash_brand"
                        android:textColor="@color/warm_charcoal"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password reset"
                    android:textColor="@color/warm_charcoal"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp"
                    android:text="Please reset password"
                    android:textColor="@color/warm_grey"
                    android:textSize="14sp" />

                <!-- Password Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_cream_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:boxBackgroundMode="none"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="@color/warm_grey">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="NEW PASSWORD"
                            android:inputType="textPassword"
                            android:textColor="@color/warm_charcoal"
                            android:textColorHint="@color/warm_grey" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="none"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="@color/warm_grey">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="CONFIRM PASSWORD"
                            android:inputType="textPassword"
                            android:textColor="@color/warm_charcoal"
                            android:textColorHint="@color/warm_grey" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Reset Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmReset"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Reset"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:backgroundTint="@color/steel_blue"
                    app:cornerRadius="30dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackStep3"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/back"
                    android:textColor="@color/warm_grey"
                    android:textSize="13sp" />

            </LinearLayout>
        </ScrollView>

    </ViewFlipper>
</LinearLayout>
