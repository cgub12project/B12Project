<?xml version="1.0" encoding="utf-8"?>
<!-- 郵件列表卡片（8/17 改版）：版面與配色規則跟 item_message.xml 完全一致，
     差別只在多了一個就地展開的操作面板。所有文字顏色同樣由 EmailAdapter
     依卡片風險底色設定，這裡不寫死。

     名稱那一行放的是「主旨」（設計稿指定），寄件人退到上面的來源行。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/emailRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="top"
        android:clickable="true"
        android:focusable="true">

        <!-- Avatar -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_glyph_mail"
            android:contentDescription="Avatar" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Row 1: 寄件人 + 時間 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvItemSource"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvItemTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- 主旨。太長一律省略號，不換行 -->
            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvItemContentLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mail_content_label"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- 內容預覽 -->
            <TextView
                android:id="@+id/tvItemMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="6dp" />

            <!-- Tags Row — chipSpacingVertical 縮小，理由同 item_message.xml -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingVertical="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Expand-in-place action panel（點擊列表項目後往下展開，封鎖這個寄件人／查看完整內容）
         圖示與電話頁使用同一組 drawable，維持全 App 一致 -->
    <LinearLayout
        android:id="@+id/expandPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnEmailBlock"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/block"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_block" />

        <!-- 只有透過信箱連接讀到的真實郵件（見 EmailAdapter.kt）才會顯示，
             通知擷取的項目沒有完整內容可看，這個按鈕預設隱藏 -->
        <ImageView
            android:id="@+id/btnEmailDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="查看完整內容"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_more"
            android:visibility="gone" />

        <!-- 回報此寄件人為詐騙：跟 btnEmailDetail 一樣，只有透過信箱連接讀到的真實郵件
             （sender 是真正的 email 地址，不是顯示名稱）才顯示，避免踩到跟社群帳號回報
             一樣的「同名不同人誤合併」風險——真實 email 地址本身就是唯一識別碼，沒有這個問題。
             通知擷取的項目（目前只剩 Outlook）sender 仍是顯示名稱，繼續隱藏。 -->
        <ImageView
            android:id="@+id/btnEmailReport"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="回報此寄件人為詐騙"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_report"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
