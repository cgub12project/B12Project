<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable list item for messages/emails -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/sym_action_chat"
        android:contentDescription="Avatar" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="11dp">

        <!-- Row 1: Name + Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LINE 群組：台灣投資達人"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvItemTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:23"
                android:textSize="11sp"
                android:textColor="@color/lbl3"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Source -->
        <TextView
            android:id="@+id/tvItemSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="陳大富 · 可疑帳號"
            android:textSize="11sp"
            android:textColor="#8C8480"
            android:layout_marginBottom="3dp" />

        <!-- Message Preview -->
        <TextView
            android:id="@+id/tvItemMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="哥，上次那個台幣計畫你考慮了嗎..."
            android:textSize="13sp"
            android:textColor="@color/lbl2"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginBottom="5dp" />

        <!-- Tags Row -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
