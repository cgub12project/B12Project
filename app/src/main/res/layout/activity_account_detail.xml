<?xml version="1.0" encoding="utf-8"?>
<!-- 12. 帳號威脅檔案 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Dark Hero Section -->
    <LinearLayout
        android:id="@+id/detailHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_blue"
        android:padding="16dp">

        <!-- Back -->
        <LinearLayout
            android:id="@+id/btnBackToThread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/back_to_thread"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF" />
        </LinearLayout>

        <!-- Account Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/detAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:contentDescription="Avatar" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvDetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="陳大富"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvDetId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LINE ID: chen_rich_888"
                    android:textSize="10sp"
                    android:textColor="#66FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Score Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Risk Ring (placeholder) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/bg_score_ring_box">

                <ProgressBar
                    android:id="@+id/riskRing"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:max="100"
                    android:progress="91" />

                <TextView
                    android:id="@+id/tvRingVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="91"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FF8A80" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/risk_score"
                    android:textSize="9sp"
                    android:textColor="#66FFFFFF" />
            </LinearLayout>

            <!-- Suspect Messages -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/bg_score_ring_box">

                <TextView
                    android:id="@+id/tvDetMsgs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14 則"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FF8A80" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suspect_msgs"
                    android:textSize="9sp"
                    android:textColor="#66FFFFFF" />
            </LinearLayout>

            <!-- Contact Days -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/bg_score_ring_box">

                <TextView
                    android:id="@+id/tvDetDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 天"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFD180" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_days"
                    android:textSize="9sp"
                    android:textColor="#66FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Triggered Rules -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/triggered_rules"
                android:textSize="11sp"
                android:textColor="@color/lbl3"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:paddingBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <!-- Evidence Summary -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/evidence_summary"
                android:textSize="11sp"
                android:textColor="@color/lbl3"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:paddingBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEvidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>

    <!-- Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBlockReport"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/block_report" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareWarning"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/share_warning" />
    </LinearLayout>
</LinearLayout>
